node_modules/
out/
release/
dist/
.DS_Store

# Local Claude/Codex machine config
.claude/settings.local.json
.claude/*.local.json

# Local design assets and working files
design/
work/

# Local-only env overrides (e.g. IR_LAB_URL_SCHEME for testing the IR Lab connector locally --
# see src/main/irLabConnector.ts). Never committed: the official value is injected at build time
# via GitHub Actions secrets, the same pattern already used for CSC_KEY_PASSWORD etc.
.env
.env.local

# Native WASM module: fetched deps and build output.
# These are listed here at the repo root rather than only in native/nam-wasm/.gitignore
# because that nested file doesn't exist on branches without the native module — checking
# such a branch out leaves these directories on disk as untracked-but-no-longer-ignored,
# and a `git add -A` then sweeps ~15MB of Eigen into the commit. (That is exactly how it
# got committed to master in 924cee7.)
native/nam-wasm/deps/
native/nam-wasm/build/
